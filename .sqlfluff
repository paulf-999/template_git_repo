# For a full reference of the SQLFluff rules, see https://docs.sqlfluff.com/en/stable/rules.html
[sqlfluff]
dialect = snowflake
templater = jinja
# templater = dbt
# The dbt templater is slower than the jinja templater, as it first compiles the dbt code into data warehouse code. If you don't need to use the dbt templater, uncomment the line below
# Number of passes to run before admitting defeat
runaway_limit = 10
max_line_length = 120
sql_file_exts = .sql,.sql.j2,.dml,.ddl
# Very large files can make the parser effectively hang
large_file_skip_byte_limit = 30000

#-----------------------------------------------------------------------------------
# General Formatting Rules
#-----------------------------------------------------------------------------------
[sqlfluff:indentation]
indent_unit = space
tab_space_size = 4
indented_joins = true
indented_using_on = true
template_blocks_indent = true

#-----------------------------------------------------------------------------------
# Comma rules
#-----------------------------------------------------------------------------------
[sqlfluff:layout:type:comma]
line_position = leading
# trailing commas within select clauses
[sqlfluff:rules:convention.select_trailing_comma]
select_clause_trailing_comma = forbid

#-----------------------------------------------------------------------------------
# Capitalisation rules
#-----------------------------------------------------------------------------------
# Inconsistent capitalisation of keywords.
[sqlfluff:rules:capitalisation.keywords]
capitalisation_policy = upper
# Inconsistent column, table, CTE & other names
[sqlfluff:rules:capitalisation.identifiers]
extended_capitalisation_policy = consistent
ignore_words = None
# Inconsistent capitalisation of function names.
[sqlfluff:rules:capitalisation.functions]
extended_capitalisation_policy = upper
# Inconsistent capitalisation of null & boolean literals.
[sqlfluff:rules:capitalisation.literals]
capitalisation_policy = upper
# Inconsistent capitalisation of data types.
[sqlfluff:rules:capitalisation.types]
extended_capitalisation_policy = upper

# Other
# Use column names in group by statements.
[sqlfluff:rules:ambiguous.column_references]
group_by_and_order_by_style = explicit
# The minimum length of an alias to allow without raising a violation.
[sqlfluff:rules:aliasing.length]
min_alias_length = 3
# Some rules can be configured from the config common to other rules
[sqlfluff:rules]
allow_scalar = true
# table references aren't necessary in statements with a single table.
single_table_references = unqualified
unquoted_identifiers_policy = all

#-----------------------------------------------------------------------------------
# Templater rules
#-----------------------------------------------------------------------------------
[sqlfluff:templater]
unwrap_wrapped_queries = true

# pass in our dbt project/cred details
[sqlfluff:templater:dbt]
project_dir =
profiles_dir =
profile =

# Default values for custom DBT macro context
[sqlfluff:templater:dbt:context]

[sqlfluff:templater:jinja]
apply_dbt_builtins = true
